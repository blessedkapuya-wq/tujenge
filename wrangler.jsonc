{
  "name": "tujenge",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biashara-base-preview-db",
      "database_id": "3530b96f-dc58-4e2e-b327-f174ed858361"
    }
  ]
}